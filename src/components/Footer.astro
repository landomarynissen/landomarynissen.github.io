---
// The bottom of every page: a quiet strip with the email and the social links.
// Pass mini to leave out the email (the contact page already shows it).
import { site } from '../site.js';

const { mini = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    {
      !mini && (
        <p class="site-footer__contact">
          <span>Get in touch</span>
          <a class="site-footer__email press" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </p>
      )
    }
    <ul class="site-footer__links">
      <li><a class="press" href={site.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
      <li><a class="press" href={site.instagram} rel="noopener noreferrer">Instagram</a></li>
    </ul>
    <p class="site-footer__copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  /* A step darker than the page, so it reads as the end without a line. */
  .site-footer {
    margin-top: clamp(4rem, 9vw, 7.5rem);
    background: var(--linen);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
    font-size: var(--size-small);
  }

  .site-footer__contact {
    display: grid;
    gap: var(--space-1);
  }

  .site-footer__email {
    justify-self: start;
    max-width: 100%;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-6);
  }

  .site-footer__links a {
    display: inline-block;
    padding-block: 0.625rem;
  }

  @media (min-width: 64rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto auto;
      align-items: end;
      gap: var(--space-12);
    }

    .site-footer__copy {
      padding-block: 0.625rem;
    }
  }
</style>
