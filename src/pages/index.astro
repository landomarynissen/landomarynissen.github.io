---
// Home page: the name, one sentence, then the work: one big project and
// the others in a grid of four.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { link } from '../site.js';

// All projects, in the order set by "order" in each project file.
// The first one is shown big, the rest go in the grid.
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [first, ...rest] = projects;
---

<Base>
  <section class="wrap opening">
    <h1 class="opening__name rise">Lando Marynissen</h1>
    <div class="opening__row">
      <p class="opening__sentence rise" style="--i:1">
        Junior graphic designer. Branding and editorial.
      </p>
    </div>
  </section>

  <section class="wrap work" aria-labelledby="work-heading">
    <div class="work__top">
      <h2 class="heading" id="work-heading">Selected work</h2>
      <a href={link('/work/')}>All work as a list</a>
    </div>

    <div class="rise" style="--i:3">
      <ProjectCard project={first} shape="16 / 9" sizes="(min-width: 100rem) 1520px, 94vw" eager />
    </div>

    <ul class="work__grid">
      {
        rest.map((project) => (
          <li class="reveal">
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap about reveal" aria-labelledby="about-heading">
    <h2 class="heading" id="about-heading">About</h2>
    <div class="about__body">
      <p class="about__text">
        I graduated magna cum laude in graphic and digital media from Artevelde in Ghent, with
        an exchange semester in Denmark.
      </p>
      <p><a class="button" href={link('/about/')}>More about me →</a></p>
    </div>
  </section>
</Base>

<style>
  /* "container-type" lets the name size itself to the width of this block. */
  .opening {
    container-type: inline-size;
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  /* The name runs the full width of the page, on one line, at every size. */
  .opening__name {
    font-family: var(--font-display);
    font-size: 11.1cqi;
    font-weight: var(--display-weight);
    font-stretch: var(--display-width);
    letter-spacing: -0.035em;
    line-height: 0.95;
    white-space: nowrap;
    margin-left: -0.04em; /* lines the L up with the page edge */
  }

  .opening__row {
    display: grid;
    gap: var(--space-6);
    margin-top: clamp(1rem, 2.5vw, 2rem);
  }

  .opening__sentence {
    max-width: 22em;
    font-size: clamp(1.25rem, 1rem + 1.25vw, 2.25rem);
    line-height: 1.2;
    text-wrap: pretty;
  }

  .opening__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .work {
    display: grid;
    gap: var(--gutter);
  }

  .work__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .work__grid {
    display: grid;
    gap: var(--gutter);
  }

  .about {
    display: grid;
    gap: var(--space-4) var(--gutter);
    margin-top: clamp(4rem, 9vw, 7.5rem);
  }

  .about__body {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .about__text {
    max-width: 24em;
    font-size: var(--size-lead);
    line-height: 1.25;
    text-wrap: pretty;
  }

  @media (min-width: 40rem) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 48rem) {
    .opening__row {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    /* Heading on the left, text in the right-hand column, like the banners. */
    .about {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
