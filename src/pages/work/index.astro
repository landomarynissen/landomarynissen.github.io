---
// The work index: every project in one plain list.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { link } from '../../site.js';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work" description="Selected work by Lando Marynissen: brand identities, editorial design and campaigns.">
  <section class="wrap index">
    <h1 class="title">Work</h1>

    <ol class="index__list">
      {
        projects.map((project) => {
          const p = project.data;
          return (
            <li>
              <a class="row" href={link(`/work/${project.id}/`)}>
                <span class="row__number">{String(p.order).padStart(2, '0')}</span>
                <span class="row__thumb">
                  {/* Empty alt: the title next to it already says what this is. */}
                  <Image src={p.cover} alt="" widths={[160, 320, 480]} sizes="(min-width: 48rem) 160px, 96px" loading="lazy" />
                </span>
                <span class="row__title">{p.title}</span>
                <span class="row__discipline">{p.discipline}</span>
                <span class="row__kind label">{p.kind}</span>
                <span class="row__year">{p.year}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>

<style>
  .index {
    padding-top: clamp(2.5rem, 7vw, 6rem);
  }

  .index__list {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--linen);
  }

  /* Phone layout: small picture on the left, text stacked on the right. */
  .row {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    grid-template-areas:
      'thumb title year'
      'thumb discipline discipline'
      'thumb kind kind';
    gap: var(--space-1) var(--space-4);
    align-items: start;
    padding-block: var(--space-4);
    border-top: 1px solid var(--linen);
    text-decoration: none;
    transition: background-color var(--time-hover) ease;
  }

  .row__number {
    display: none;
  }

  .row__thumb {
    grid-area: thumb;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--linen);
  }

  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .row__title {
    grid-area: title;
    font-size: var(--size-body);
    font-weight: 600;
    line-height: 1.25;
  }

  .row__discipline {
    grid-area: discipline;
    font-size: var(--size-small);
    color: var(--ink-soft);
  }

  .row__kind {
    grid-area: kind;
  }

  .row__year,
  .row__number {
    font-size: var(--size-small);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .row__year {
    grid-area: year;
  }

  /* Tablet and up: one line per project, like a table. */
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 2.5rem 10rem minmax(0, 2.2fr) minmax(0, 1.4fr) minmax(0, 1fr) 3rem;
      grid-template-areas: 'number thumb title discipline kind year';
      align-items: center;
      gap: var(--gutter);
      padding: var(--space-4) var(--space-3);
      margin-inline: calc(var(--space-3) * -1);
      border-radius: var(--radius);
    }

    .row__number {
      display: block;
      grid-area: number;
    }

    .row__thumb {
      aspect-ratio: 3 / 2;
    }

    .row__title {
      font-family: var(--font-display);
      font-size: clamp(1.25rem, 0.8rem + 1.4vw, 2.25rem);
      font-stretch: var(--display-width);
      letter-spacing: var(--display-tracking);
      line-height: 1.05;
    }

    .row__year {
      text-align: right;
    }
  }

  /* With a mouse: the row you point at takes the palest blue. */
  @media (hover: hover) and (pointer: fine) {
    .row:hover {
      background: var(--blue-14);
    }
  }
</style>
